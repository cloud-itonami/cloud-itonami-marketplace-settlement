{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). This repo
 ;; Pinned by git coordinate. This repo IS standalone and CI checks it out
 ;; alone, so a sibling path never resolved there -- the classpath failed to
 ;; build before any test ran.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        ;; integer split allocation, payout destinations and escrow
        ;; (ADR-2607264000). The arithmetic lives there, behind
        ;; kotoba-lang/pay's zero-custody boundary -- this actor governs it,
        ;; it does not reimplement it.
        io.github.kotoba-lang/marketplace
        {:git/url "https://github.com/kotoba-lang/marketplace.git"
         :git/sha "7ed9642f924f3cd01aa670d48d6cf56215d1b132"}
        ;; HOST half only (`settleops.edge.worker`): q / pull / datoms / transact
        ;; against kotobase.net with a per-request CACAO. The actor core
        ;; stays portable .cljc with no network I/O.
        io.github.kotoba-lang/kotobase-client
        {:git/url "https://github.com/kotoba-lang/kotobase-client.git"
         :git/sha "f88a46930e4209c4346c0ef78f3795a948bf73b6"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  :run {:main-opts ["-m" "settleops.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  ;; What `shadow-cljs.edn` resolves: the :cljs deps plus the test path, so
  ;; the same portable suite runs under a ClojureScript host. Kept separate
  ;; from :test because shadow-cljs passes the alias to `clojure -A`, where
  ;; that alias's :main-opts reach the wrong main and the build dies.
  :cljs-test {:extra-paths ["test"]
              :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                           thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
